# Copy to .env and edit. Every setting has a default except MODELS_DIR.

# Directory holding DeepSeek-V4.1-Flash-1017-hybrid/ and DeepSeek-V4.1-Flash-1017-engram/ (tools/download.sh
# fetches the parts, tools/make_hybrid.py assembles the hybrid view). Fast NVMe: Engram rows are read from it.
MODELS_DIR=/path/to/models

# tp4 = tensor parallel over 4 cards (needs PCIe x16 links and working P2P; fastest per request)
# pp4 = pipeline parallel over 4 cards (activations only cross the links; for x1/x4 links)
LAYOUT=tp4
# pp4 only: layers per stage (the last stage also holds the head and the drafter)
# PP_PARTITION=10,11,11,8

# The API has no authentication, so it is published on this host only. Use an SSH local forward from other
# machines (see README, "Serving other machines") rather than widening BIND.
BIND=127.0.0.1
PORT=8000

# 262144 (default) or up to 1048576 (the model's native context; slightly slower at high concurrency)
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.95

# 1 = NCCL may use GPU peer-to-peer (needs a P2P-capable driver); 0 = through host memory
P2P=1

# Confidence-gated verification: the target verifies DSpark drafts only while the running product of the drafter's
# confidences stays at or above this value (default 0.10; 0 = verify all 5 drafts). Output is the same either way.
# DSV41_GATE_TAU=0.10
# Runtime variants applied before CUDA graph capture (default: all twelve for tp4, the four of 1.1.0 for pp4;
# empty = none, the A side of an A/B)
# DSV41_VARIANTS=dsv41_topk_meta,dsv41_h2d_lean,dsv41_ragged_lean,dsv41_gate
# Per-step verify width (tp4): 3 or 5 drafts per step from each request's recent acceptance (default accept:3,5;
# empty = always 5). Same accepted tokens; narrower steps cost less.
# DSV41_DYNK=accept:3,5

IMAGE=ds41-cmp170hx:latest
NAME=ds41-flash
CACHE_DIR=./cache
